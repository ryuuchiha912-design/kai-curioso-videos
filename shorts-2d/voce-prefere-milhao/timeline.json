 58.616}, {"text": "pra", "start": 58.676, "end": 58.856}, {"text": "sempre", "start": 58.869, "end": 59.337}, {"text": "é", "start": 59.349, "end": 59.457}, {"text": "o", "start": 59.469, "end": 59.53}, {"text": "seu", "start": 59.542, "end": 59.734}, {"text": "pra", "start": 59.746, "end": 59.89}, {"text": "sempre", "start": 59.902, "end": 60.407}, {"text": "Se", "start": 61.234, "end": 61.439}, {"text": "você", "start": 61.451, "end": 61.787}, {"text": "se", "start": 61.799, "end": 61.931}, {"text": "for", "start": 61.944, "end": 62.22}, {"text": "o", "start": 62.581, "end": 62.629}, {"text": "dinheiro", "start": 62.641, "end": 63.073}, {"text": "para", "start": 63.085, "end": 63.41}, {"text": "A", "start": 64.239, "end": 64.335}, {"text": "sua", "start": 64.347, "end": 64.552}, {"text": "família", "start": 64.564, "end": 64.972}, {"text": "não", "start": 64.984, "end": 65.129}, {"text": "recebe", "start": 65.141, "end": 65.573}, {"text": "nada", "start": 65.585, "end": 65.946}]}, {"cap": "E o milhão? Esse fica pra quem você ama.", "start": 66.686, "end": 69.701, "audio_at": 66.626, "dur": 3.254916, "words": [{"text": "E", "start": 66.686, "end": 66.818}, {"text": "o", "start": 66.83, "end": 66.866}, {"text": "milhão", "start": 66.878, "end": 67.323}, {"text": "Esse", "start": 68.15, "end": 68.451}, {"text": "fica", "start": 68.463, "end": 68.715}, {"text": "pra", "start": 68.727, "end": 68.859}, {"text": "quem", "start": 68.872, "end": 69.028}, {"text": "você", "start": 69.04, "end": 69.352}, {"text": "ama", "start": 69.364, "end": 69.701}]}, {"cap": "Então me diz:", "start": 70.441, "end": 71.354, "audio_at": 70.381, "dur": 1.1534579999999999, "words": [{"text": "Então", "start": 70.441, "end": 70.85}, {"text": "me", "start": 70.862, "end": 70.958}, {"text": "diz", "start": 70.97, "end": 71.354}]}, {"cap": "A: um milhão agora. Ou B: dez mil por mês, pra sempre.", "start": 71.794, "end": 76.949, "audio_at": 71.734, "dur": 5.394290999999999, "words": [{"text": "A", "start": 71.794, "end": 72.047}, {"text": "um", "start": 72.227, "end": 72.335}, {"text": "milhão", "start": 72.347, "end": 72.708}, {"text": "agora", "start": 72.72, "end": 73.14}, {"text": "Ou", "start": 73.968, "end": 74.148}, {"text": "B", "start": 74.16, "end": 74.497}, {"text": "dez", "start": 74.821, "end": 75.218}, {"text": "mil", "start": 75.23, "end": 75.434}, {"text": "por", "start": 75.446, "end": 75.614}, {"text": "mês", "start": 75.627, "end": 76.035}, {"text": "pra", "start": 76.264, "end": 76.432}, {"text": "sempre", "start": 76.444, "end": 76.949}]}, {"cap": "Comenta A ou B… e o que você faria primeiro com o dinheiro.", "start": 77.489, "end": 80.854, "audio_at": 77.429, "dur": 3.6053750000000004, "words": [{"text": "Comenta", "start": 77.489, "end": 78.017}, {"text": "A", "start": 78.029, "end": 78.114}, {"text": "ou", "start": 78.126, "end": 78.246}, {"text": "B", "start": 78.258, "end": 78.582}, {"text": "e", "start": 78.895, "end": 78.991}, {"text": "o", "start": 79.003, "end": 79.051}, {"text": "que", "start": 79.063, "end": 79.183}, {"text": "você", "start": 79.195, "end": 79.436}, {"text": "faria", "start": 79.448, "end": 79.76}, {"text": "primeiro", "start": 79.772, "end": 80.181}, {"text": "com", "start": 80.193, "end": 80.361}, {"text": "o", "start": 80.373, "end": 80.409}, {"text": "dinheiro", "start": 80.421, "end": 80.854}]}]}