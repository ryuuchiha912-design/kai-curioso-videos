 "end": 24.252}]}, {"cap": "E tem muita história de gente que ganhou uma bolada… e em poucos anos não tinha mais nada.", "start": 24.892, "end": 29.495, "audio_at": 24.832, "dur": 4.843374, "words": [{"text": "E", "start": 24.892, "end": 25.0}, {"text": "tem", "start": 25.012, "end": 25.204}, {"text": "muita", "start": 25.216, "end": 25.517}, {"text": "história", "start": 25.529, "end": 25.877}, {"text": "de", "start": 25.889, "end": 25.986}, {"text": "gente", "start": 25.998, "end": 26.346}, {"text": "que", "start": 26.358, "end": 26.442}, {"text": "ganhou", "start": 26.454, "end": 26.683}, {"text": "uma", "start": 26.695, "end": 26.827}, {"text": "bolada", "start": 26.839, "end": 27.344}, {"text": "e", "start": 27.536, "end": 27.584}, {"text": "em", "start": 27.596, "end": 27.728}, {"text": "poucos", "start": 27.74, "end": 28.065}, {"text": "anos", "start": 28.077, "end": 28.462}, {"text": "não", "start": 28.474, "end": 28.63}, {"text": "tinha", "start": 28.642, "end": 28.894}, {"text": "mais", "start": 28.906, "end": 29.147}, {"text": "nada", "start": 29.159, "end": 29.495}]}, {"cap": "Mas, se você guardar e investir, esse milhão pode render alguns milhares por mês… sem acabar.", "start": 30.135, "end": 35.844, "audio_at": 30.075, "dur": 5.949166999999999, "words": [{"text": "Mas", "start": 30.135, "end": 30.604}, {"text": "se", "start": 30.796, "end": 30.94}, {"text": "você", "start": 30.952, "end": 31.217}, {"text": "guardar", "start": 31.229, "end": 31.686}, {"text": "e", "start": 31.698, "end": 31.722}, {"text": "investir", "start": 31.734, "end": 32.239}, {"text": "esse", "start": 32.539, "end": 32.719}, {"text": "milhão", "start": 32.731, "end": 33.008}, {"text": "pode", "start": 33.02, "end": 33.236}, {"text": "render", "start": 33.248, "end": 33.561}, {"text": "alguns", "start": 33.573, "end": 33.909}, {"text": "milhares", "start": 33.921, "end": 34.354}, {"text": "por", "start": 34.366, "end": 34.546}, {"text": "mês", "start": 34.558, "end": 34.955}, {"t