{"total": 142.722, "lines": [{"cap": "No dia em que todos os pais do mundo viraram crianças, eu tinha dezesseis anos.", "start": 0.36, "end": 4.62, "audio_at": 0.3, "dur": 4.499707999999999, "words": [{"text": "No", "start": 0.36, "end": 0.518}, {"text": "dia", "start": 0.53, "end": 0.736}, {"text": "em", "start": 0.748, "end": 0.809}, {"text": "que", "start": 0.821, "end": 0.955}, {"text": "todos", "start": 0.967, "end": 1.27}, {"text": "os", "start": 1.282, "end": 1.452}, {"text": "pais", "start": 1.464, "end": 1.695}, {"text": "do", "start": 1.707, "end": 1.792}, {"text": "mundo", "start": 1.804, "end": 2.108}, {"text": "viraram", "start": 2.12, "end": 2.435}, {"text": "crianças", "start": 2.447, "end": 3.042}, {"text": "eu", "start": 3.26, "end": 3.37}, {"text": "tinha", "start": 3.382, "end": 3.637}, {"text": "dezesseis", "start": 3.649, "end": 4.098}, {"text": "anos", "start": 4.11, "end": 4.62}]}, {"cap": "Acordei com um barulho na cozinha. Era a minha mãe… com seis anos de idade, tentando alcançar o armário.", "start": 5.36, "end": 12.069, "audio_at": 5.3, "dur": 6.949707999999999, "words": [{"text": "Acordei", "start": 5.36, "end": 5.93}, {"text": "com", "start": 5.942, "end": 6.1}, {"text": "um", "start": 6.112, "end": 6.161}, {"text": "barulho", "start": 6.173, "end": 6.549}, {"text": "na", "start": 6.561, "end": 6.67}, {"text": "cozinha", "start": 6.683, "end": 7.204}, {"text": "Era", "start": 8.04, "end": 8.259}, {"text": "a", "start": 8.271, "end": 8.295}, {"text": "minha", "start": 8.307, "end": 8.514}, {"text": "mãe", "start": 8.526, "end": 8.817}, {"text": "com", "start": 9.096, "end": 9.266}, {"text": "seis", "start": 9.278, "end": 9.484}, {"text": "anos", "start": 9.497, "end": 9.836}, {"text": "de", "start": 9.849, "end": 9.921}, {"text": "idade", "start": 9.933, "end": 10.358}, {"text": "tentando", "start": 10.577, "end": 10.989}, {"text": "alcançar", "start": 11.001, "end": 11.523}, {"text": "o", "start": 11.535, "end": 11.596}, {"text": "armário", "start": 11.608, "end": 12.069}]}, {"cap": "Meu pai tava no sofá, do tamanho de um menino de sete, chorando porque não sabia amarrar o tênis.", "start": 12.709, "end": 18.328, "audio_at": 12.649, "dur": 5.858915999999999, "words": [{"text": "Meu", "start": 12.709, "end": 12.976}, {"text": "pai", "start": 12.989, "end": 13.231}, {"text": "tava", "start": 13.243, "end": 13.498}, {"text": "no", "start": 13.51, "end": 13.595}, {"text": "sofá", "start": 13.607, "end": 13.984}, {"text": "do", "start": 14.178, "end": 14.287}, {"text": "tamanho", "start": 14.299, "end": 14.712}, {"text": "de", "start": 14.724, "end": 14.809}, {"text": "um", "start": 14.821, "end": 14.882}, {"text": "menino", "start": 14.894, "end": 15.258}, {"text": "de", "start": 15.27, "end": 15.391}, {"text": "sete", "start": 15.404, "end": 15.804}, {"text": "chorando", "start": 16.12, "end": 16.544}, {"text": "porque", "start": 16.556, "end": 16.836}, {"text": "não", "start": 16.848, "end": 17.005}, {"text": "sabia", "start": 17.018, "end": 17.382}, {"text": "amarrar", "start": 17.394, "end": 17.77}, {"text": "o", "start": 17.782, "end": 17.855}, {"text": "tênis", "start": 17.867, "end": 18.328}]}, {"cap": "No começo, eu ri. Agora eles iam me obedecer! Sem castigo, sem \"vai arrumar o quarto\".", "start": 19.068, "end": 26.312, "audio_at": 19.008, "dur": 7.483667, "words": [{"text": "No", "start": 19.068, "end": 19.25}, {"text": "começo", "start": 19.262, "end": 19.821}, {"text": "eu", "start": 19.966, "end": 20.148}, {"text": "ri", "start": 20.161, "end": 20.391}, {"text": "Agora", "start": 21.227, "end": 21.725}, {"text": "eles", "start": 21.737, "end": 21.943}, {"text": "iam", "start": 21.955, "end": 22.246}, {"text": "me", "start": 22.259, "end": 22.368}, {"text": "obedecer", "start": 22.38, "end": 23.023}, {"text": "Sem", "start": 23.861, "end": 24.164}, {"text": "castigo", "start": 24.176, "end": 24.71}, {"text": "sem", "start": 24.977, "end": 25.171}, {"text": "vai", "start": 25.232, "end": 25.39}, {"text": "arrumar", "start": 25.402, "end": 25.79}, {"text": "o", "start": 25.802, "end": 25.863}, {"text": "quarto", "start": 25.875, "end": 26.312}]}, {"cap": "Meu pai pequeno olhou pra mim e perguntou: \"Você é o adulto agora?\"", "start": 26.952, "end": 30.738, "audio_at": 26.892, "dur": 4.026375, "words": [{"text": "Meu", "start": 26.952, "end": 27.219}, {"text": "pai", "start": 27.231, "end": 27.474}, {"text": "pequeno", "start": 27.486, "end": 27.838}, {"text": "olhou", "start": 27.85, "end": 28.056}, {"text": "pra", "start": 28.068, "end": 28.214}, {"text": "mim", "start": 28.226, "end": 28.433}, {"text": "e", "start": 28.445, "end": 28.493}, {"text": "perguntou", "start": 28.505, "end": 29.076}, {"text": "Você", "start": 29.501, "end": 29.84}, {"text": "é", "start": 29.852, "end": 29.925}, {"text": "o", "start": 29.937, "end": 30.01}, {"text": "adulto", "start": 30.022, "end": 30.338}, {"text": "agora", "start": 30.35, "end": 30.738}]}, {"cap": "No primeiro dia, eu deixei os dois comerem doce no café da manhã. Às dez horas, tavam os dois com dor de barriga.", "start": 31.478, "end": 38.54, "audio_at": 31.418, "dur": 7.301625, "words": [{"text": "No", "start": 31.478, "end": 31.636}, {"text": "primeiro", "start": 31.648, "end": 32.0}, {"text": "dia", "start": 32.012, "end": 32.304}, {"text": "eu", "start": 32.534, "end": 32.643}, {"text": "deixei", "start": 32.656, "end": 32.971}, {"text": "os", "start": 32.983, "end": 33.068}, {"text": "dois", "start": 33.08, "end": 33.335}, {"text": "comerem", "start": 33.347, "end": 33.699}, {"text": "doce", "start": 33.711, "end": 34.075}, {"text": "no", "start": 34.088, "end": 34.173}, {"text": "café", "start": 34.185, "end": 34.512}, {"text": "da", "start": 34.524, "end": 34.609}, {"text": "manhã", "start": 34.622, "end": 34.949}, {"text": "Às", "start": 35.785, "end": 35.955}, {"text": "dez", "start": 35.967, "end": 36.137}, {"text": "horas", "start": 36.149, "end": 36.598}, {"text": "tavam", "start": 36.817, "end": 37.084}, {"text": "os", "start": 37.096, "end": 37.205}, {"text": "dois", "start": 37.217, "end": 37.533}, {"text": "com", "start": 37.545, "end": 37.715}, {"text": "dor", "start": 37.727, "end": 37.97}, {"text": "de", "start": 37.982, "end": 38.055}, {"text": "barriga", "start": 38.067, "end": 38.54}]}, {"cap": "Eu tive que fazer a comida. Queimei o arroz duas vezes.", "start": 39.18, "end": 43.183, "audio_at": 39.12, "dur": 4.2433749999999995, "words": [{"text": "Eu", "start": 39.18, "end": 39.362}, {"text": "tive", "start": 39.374, "end": 39.629}, {"text": "que", "start": 39.641, "end": 39.75}, {"text": "fazer", "start": 39.763, "end": 40.066}, {"text": "a", "start": 40.078, "end": 40.127}, {"text": "comida", "start": 40.139, "end": 40.6}, {"text": "Queimei", "start": 41.436, "end": 41.836}, {"text": "o", "start": 41.848, "end": 41.909}, {"text": "arroz", "start": 41.921, "end": 42.297}, {"text": "duas", "start": 42.31, "end": 42.686}, {"text": "vezes", "start": 42.698, "end": 43.183}]}, {"cap": "Minha mãe comeu mesmo assim e disse: \"Tá gostoso!\" Ela mentiu. Do jeito que eu mentia pra ela.", "start": 43.923, "end": 51.058, "audio_at": 43.863, "dur": 7.374499999999999, "words": [{"text": "Minha", "start": 43.923, "end": 44.19}, {"text": "mãe", "start": 44.202, "end": 44.445}, {"text": "comeu", "start": 44.457, "end": 44.736}, {"text": "mesmo", "start": 44.749, "end": 45.101}, {"text": "assim", "start": 45.113, "end": 45.404}, {"text": "e", "start": 45.416, "end": 45.452}, {"text": "disse", "start": 45.465, "end": 45.877}, {"text": "Tá", "start": 46.047, "end": 46.193}, {"text": "gostoso", "start": 46.205, "end": 46.836}, {"text": "Ela", "start": 47.672, "end": 47.951}, {"text": "mentiu", "start": 47.963, "end": 48.473}, {"text": "Do", "start": 49.31, "end": 49.504}, {"text": "jeito", "start": 49.517, "end": 49.917}, {"text": "que", "start": 49.929, "end": 50.014}, {"text": "eu", "start": 50.026, "end": 50.099}, {"text": "mentia", "start": 50.111, "end": 50.487}, {"text": "pra", "start": 50.5, "end": 50.694}, {"text": "ela", "start": 50.706, "end": 51.058}]}, {"cap": "Na hora de dormir, minha mãe pequena pediu: \"Deixa a luz acesa? Eu tenho medo do escuro.\"", "start": 51.798, "end": 57.998, "audio_at": 51.738, "dur": 6.4399999999999995, "words": [{"text": "Na", "start": 51.798, "end": 52.004}, {"text": "hora", "start": 52.016, "end": 52.295}, {"text": "de", "start": 52.308, "end": 52.405}, {"text": "dormir", "start": 52.417, "end": 52.817}, {"text": "minha", "start": 53.072, "end": 53.291}, {"text": "mãe", "start": 53.303, "end": 53.558}, {"text": "pequena", "start": 53.57, "end": 53.946}, {"text": "pediu", "start": 53.958, "end": 54.334}, {"text": "Deixa", "start": 54.65, "end": 54.99}, {"text": "a", "start": 55.002, "end": 55.014}, {"text": "luz", "start": 55.026, "end": 55.147}, {"text": "acesa", "start": 55.16, "end": 55.73}, {"text": "Eu", "start": 56.566, "end": 56.76}, {"text": "tenho", "start": 56.772, "end": 57.027}, {"text": "medo", "start": 57.039, "end": 57.391}, {"text": "do", "start": 57.403, "end": 57.525}, {"text": "escuro", "start": 57.537, "end": 57.998}]}, {"cap": "Eu nunca soube que a minha mãe tinha medo do escuro.", "start": 58.738, "end": 61.553, "audio_at": 58.678, "dur": 3.0555410000000003, "words": [{"text": "Eu", "start": 58.738, "end": 58.92}, {"text": "nunca", "start": 58.932, "end": 59.308}, {"text": "soube", "start": 59.32, "end": 59.697}, {"text": "que", "start": 59.709, "end": 59.782}, {"text": "a", "start": 59.794, "end": 59.842}, {"text": "minha", "start": 59.854, "end": 60.049}, {"text": "mãe", "start": 60.061, "end": 60.34}, {"text": "tinha", "start": 60.352, "end": 60.607}, {"text": "medo", "start": 60.619, "end": 60.959}, {"text": "do", "start": 60.971, "end": 61.08}, {"text": "escuro", "start": 61.092, "end": 61.553}]}, {"cap": "No segundo dia, meu pai caiu no quintal e ralou o joelho. Eu peguei ele no colo e soprei o machucado… do jeito que ele fazia comigo.", "start": 62.493, "end": 70.866, "audio_at": 62.433, "dur": 8.612333, "words": [{"text": "No", "start": 62.493, "end": 62.651}, {"text": "segundo", "start": 62.663, "end": 63.1}, {"text": "dia", "start": 63.112, "end": 63.404}, {"text": "meu", "start": 63.658, "end": 63.828}, {"text": "pai", "start": 63.84, "end": 64.071}, {"text": "caiu", "start": 64.083, "end": 64.35}, {"text": "no", "start": 64.362, "end": 64.459}, {"text": "quintal", "start": 64.472, "end": 64.993}, {"text": "e", "start": 65.006, "end": 65.042}, {"text": "ralou", "start": 65.054, "end": 65.394}, {"text": "o", "start": 65.406, "end": 65.442}, {"text": "joelho", "start": 65.455, "end": 65.904}, {"text": "Eu", "start": 66.74, "end": 66.897}, {"text": "peguei", "start": 66.909, "end": 67.274}, {"text": "ele", "start": 67.286, "end": 67.419}, {"text": "no", "start": 67.431, "end": 67.553}, {"text": "colo", "start": 67.565, "end": 67.88}, {"text": "e", "start": 67.892, "end": 67.917}, {"text": "soprei", "start": 67.929, "end": 68.293}, {"text": "o", "start": 68.305, "end": 68.341}, {"text": "machucado", "start": 68.354, "end": 68.985}, {"text": "do", "start": 69.179, "end": 69.349}, {"text": "jeito", "start": 69.361, "end": 69.737}, {"text": "que", "start": 69.749, "end": 69.858}, {"text": "ele", "start": 69.871, "end": 70.016}, {"text": "fazia", "start": 70.028, "end": 70.392}, {"text": "comigo", "start": 70.405, "end": 70.866}]}, {"cap": "No terceiro dia, eu tava exausto. Lavei a louça, a roupa, levei os dois na escola… e ninguém me agradeceu.", "start": 71.706, "end": 79.156, "audio_at": 71.646, "dur": 7.6899999999999995, "words": [{"text": "No", "start": 71.706, "end": 71.863}, {"text": "terceiro", "start": 71.876, "end": 72.337}, {"text": "dia", "start": 72.349, "end": 72.64}, {"text": "eu", "start": 72.847, "end": 72.968}, {"text": "tava", "start": 72.98, "end": 73.198}, {"text": "exausto", "start": 73.211, "end": 73.708}, {"text": "Lavei", "start": 74.544, "end": 75.017}, {"text": "a", "start": 75.03, "end": 75.09}, {"text": "louça", "start": 75.102, "end": 75.515}, {"text": "a", "start": 75.624, "end": 75.709}, {"text": "roupa", "start": 75.721, "end": 76.073}, {"text": "levei", "start": 76.401, "end": 76.765}, {"text": "os", "start": 76.777, "end": 76.862}, {"text": "dois", "start": 76.874, "end": 77.141}, {"text": "na", "start": 77.153, "end": 77.214}, {"text": "escola", "start": 77.226, "end": 77.699}, {"text": "e", "start": 77.93, "end": 78.015}, {"text": "ninguém", "start": 78.027, "end": 78.403}, {"text": "me", "start": 78.415, "end": 78.476}, {"text": "agradeceu", "start": 78.488, "end": 79.156}]}, {"cap": "E aí eu entendi. A minha mãe fazia isso todo dia. Há dezesseis anos. E eu nunca agradeci.", "start": 79.896, "end": 87.868, "audio_at": 79.836, "dur": 8.211832999999999, "words": [{"text": "E", "start": 79.896, "end": 80.029}, {"text": "aí", "start": 80.041, "end": 80.272}, {"text": "eu", "start": 80.284, "end": 80.418}, {"text": "entendi", "start": 80.43, "end": 80.952}, {"text": "A", "start": 81.787, "end": 81.885}, {"text": "minha", "start": 81.897, "end": 82.115}, {"text": "mãe", "start": 82.127, "end": 82.394}, {"text": "fazia", "start": 82.406, "end": 82.88}, {"text": "isso", "start": 82.892, "end": 83.195}, {"text": "todo", "start": 83.207, "end": 83.487}, {"text": "dia", "start": 83.499, "end": 83.814}, {"text": "Há", "start": 84.652, "end": 84.773}, {"text": "dezesseis", "start": 84.785, "end": 85.258}, {"text": "anos", "start": 85.27, "end": 85.768}, {"text": "E", "start": 86.605, "end": 86.715}, {"text": "eu", "start": 86.727, "end": 86.872}, {"text": "nunca", "start": 86.885, "end": 87.249}, {"text": "agradeci", "start": 87.261, "end": 87.868}]}, {"cap": "Eu sentei no chão da cozinha e chorei.", "start": 88.808, "end": 90.834, "audio_at": 88.748, "dur": 2.2667080000000004, "words": [{"text": "Eu", "start": 88.808, "end": 88.965}, {"text": "sentei", "start": 88.977, "end": 89.427}, {"text": "no", "start": 89.439, "end": 89.536}, {"text": "chão", "start": 89.548, "end": 89.778}, {"text": "da", "start": 89.791, "end": 89.9}, {"text": "cozinha", "start": 89.912, "end": 90.397}, {"text": "e", "start": 90.41, "end": 90.446}, {"text": "chorei", "start": 90.458, "end": 90.834}]}, {"cap": "Na quarta noite, minha mãe pequena me abraçou e perguntou: \"Você vai cuidar da gente pra sempre?\"", "start": 91.774, "end": 97.138, "audio_at": 91.714, "dur": 5.604082999999999, "words": [{"text": "Na", "start": 91.774, "end": 91.956}, {"text": "quarta", "start": 91.968, "end": 92.32}, {"text": "noite", "start": 92.333, "end": 92.721}, {"text": "minha", "start": 92.939, "end": 93.146}, {"text": "mãe", "start": 93.158, "end": 93.4}, {"text": "pequena", "start": 93.413, "end": 93.801}, {"text": "me", "start": 93.813, "end": 93.91}, {"text": "abraçou", "start": 93.922, "end": 94.371}, {"text": "e", "start": 94.383, "end": 94.432}, {"text": "perguntou", "start": 94.444, "end": 94.978}, {"text": "Você", "start": 95.342, "end": 95.597}, {"text": "vai", "start": 95.609, "end": 95.731}, {"text": "cuidar", "start": 95.743, "end": 96.095}, {"text": "da", "start": 96.107, "end": 96.216}, {"text": "gente", "start": 96.228, "end": 96.519}, {"text": "pra", "start": 96.532, "end": 96.677}, {"text": "sempre", "start": 96.689, "end": 97.138}]}, {"cap": "Eu disse: \"Vou.\" Foi a primeira promessa de adulto que eu fiz na vida.", "start": 97.878, "end": 102.61, "audio_at": 97.818, "dur": 4.971540999999999, "words": [{"text": "Eu", "start": 97.878, "end": 98.06}, {"text": "disse", "start": 98.073, "end": 98.485}, {"text": "Vou", "start": 98.849, "end": 99.14}, {"text": "Foi", "start": 99.976, "end": 100.171}, {"text": "a", "start": 100.183, "end": 100.243}, {"text": "primeira", "start": 100.256, "end": 100.595}, {"text": "promessa", "start": 100.607, "end": 101.117}, {"text": "de", "start": 101.129, "end": 101.226}, {"text": "adulto", "start": 101.239, "end": 101.651}, {"text": "que", "start": 101.663, "end": 101.736}, {"text": "eu", "start": 101.748, "end": 101.845}, {"text": "fiz", "start": 101.857, "end": 102.137}, {"text": "na", "start": 102.149, "end": 102.27}, {"text": "vida", "start": 102.282, "end": 102.61}]}, {"cap": "Naquela noite, eu dormi no chão do quarto deles. Com a luz acesa.", "start": 103.55, "end": 108.209, "audio_at": 103.49, "dur": 4.89875, "words": [{"text": "Naquela", "start": 103.55, "end": 103.95}, {"text": "noite", "start": 103.963, "end": 104.339}, {"text": "eu", "start": 104.521, "end": 104.654}, {"text": "dormi", "start": 104.666, "end": 105.006}, {"text": "no", "start": 105.018, "end": 105.115}, {"text": "chão", "start": 105.128, "end": 105.358}, {"text": "do", "start": 105.37, "end": 105.467}, {"text": "quarto", "start": 105.48, "end": 105.856}, {"text": "deles", "start": 105.868, "end": 106.329}, {"text": "Com", "start": 107.165, "end": 107.383}, {"text": "a", "start": 107.396, "end": 107.432}, {"text": "luz", "start": 107.444, "end": 107.614}, {"text": "acesa", "start": 107.626, "end": 108.209}]}, {"cap": "Na manhã seguinte, tudo voltou ao normal. Minha mãe tava na cozinha, do tamanho certo, passando café.", "start": 109.149, "end": 116.186, "audio_at": 109.089, "dur": 7.277374999999999, "words": [{"text": "Na", "start": 109.149, "end": 109.294}, {"text": "manhã", "start": 109.306, "end": 109.61}, {"text": "seguinte", "start": 109.622, "end": 110.192}, {"text": "tudo", "start": 110.35, "end": 110.617}, {"text": "voltou", "start": 110.629, "end": 111.03}, {"text": "ao", "start": 111.042, "end": 111.115}, {"text": "normal", "start": 111.127, "end": 111.588}, {"text": "Minha", "start": 112.424, "end": 112.679}, {"text": "mãe", "start": 112.691, "end": 112.982}, {"text": "tava", "start": 112.994, "end": 113.225}, {"text": "na", "start": 113.237, "end": 113.334}, {"text": "cozinha", "start": 113.346, "end": 113.844}, {"text": "do", "start": 114.05, "end": 114.208}, {"text": "tamanho", "start": 114.22, "end": 114.608}, {"text": "certo", "start": 114.62, "end": 115.07}, {"text": "passando", "start": 115.337, "end": 115.761}, {"text": "café", "start": 115.773, "end": 116.186}]}, {"cap": "Ela me olhou e disse: \"Bom dia, filho. Dormiu bem?\"", "start": 116.826, "end": 121.06, "audio_at": 116.766, "dur": 4.473958999999999, "words": [{"text": "Ela", "start": 116.826, "end": 117.093}, {"text": "me", "start": 117.105, "end": 117.202}, {"text": "olhou", "start": 117.214, "end": 117.469}, {"text": "e", "start": 117.481, "end": 117.53}, {"text": "disse", "start": 117.542, "end": 117.918}, {"text": "Bom", "start": 118.197, "end": 118.44}, {"text": "dia", "start": 118.452, "end": 118.78}, {"text": "filho", "start": 119.047, "end": 119.435}, {"text": "Dormiu", "start": 120.271, "end": 120.757}, {"text": "bem", "start": 120.769, "end": 121.06}]}, {"cap": "Eu atravessei a cozinha… e abracei ela por muito tempo.", "start": 121.8, "end": 125.04, "audio_at": 121.74, "dur": 3.4802920000000004, "words": [{"text": "Eu", "start": 121.8, "end": 121.97}, {"text": "atravessei", "start": 121.982, "end": 122.492}, {"text": "a", "start": 122.504, "end": 122.565}, {"text": "cozinha", "start": 122.577, "end": 123.086}, {"text": "e", "start": 123.378, "end": 123.45}, {"text": "abracei", "start": 123.463, "end": 123.899}, {"text": "ela", "start": 123.912, "end": 124.094}, {"text": "por", "start": 124.106, "end": 124.264}, {"text": "muito", "start": 124.276, "end": 124.676}, {"text": "tempo", "start": 124.688, "end": 125.04}]}, {"cap": "Ela não entendeu nada. Mas eu entendi tudo.", "start": 125.88, "end": 129.228, "audio_at": 125.82, "dur": 3.588083, "words": [{"text": "Ela", "start": 125.88, "end": 126.111}, {"text": "não", "start": 126.123, "end": 126.317}, {"text": "entendeu", "start": 126.329, "end": 126.754}, {"text": "nada", "start": 126.766, "end": 127.118}, {"text": "Mas", "start": 127.954, "end": 128.16}, {"text": "eu", "start": 128.173, "end": 128.379}, {"text": "entendi", "start": 128.391, "end": 128.864}, {"text": "tudo", "start": 128.876, "end": 129.228}]}, {"cap": "Hoje, eu deixo a luz do corredor acesa. Ela finge que não percebe.", "start": 130.268, "end": 135.097, "audio_at": 130.208, "dur": 5.068624999999999, "words": [{"text": "Hoje", "start": 130.268, "end": 130.681}, {"text": "eu", "start": 130.875, "end": 131.021}, {"text": "deixo", "start": 131.033, "end": 131.348}, {"text": "a", "start": 131.361, "end": 131.385}, {"text": "luz", "start": 131.397, "end": 131.676}, {"text": "do", "start": 131.688, "end": 131.797}, {"text": "corredor", "start": 131.81, "end": 132.222}, {"text": "acesa", "start": 132.234, "end": 132.744}, {"text": "Ela", "start": 133.58, "end": 133.847}, {"text": "finge", "start": 133.859, "end": 134.211}, {"text": "que", "start": 134.223, "end": 134.32}, {"text": "não", "start": 134.332, "end": 134.514}, {"text": "percebe", "start": 134.527, "end": 135.097}]}, {"cap": "Se os seus pais virassem crianças amanhã, o que você faria primeiro por eles? Comenta.", "start": 136.137, "end": 141.742, "audio_at": 136.077, "dur": 5.845375, "words": [{"text": "Se", "start": 136.137, "end": 136.319}, {"text": "os", "start": 136.331, "end": 136.428}, {"text": "seus", "start": 136.44, "end": 136.659}, {"text": "pais", "start": 136.671, "end": 136.914}, {"text": "virassem", "start": 136.926, "end": 137.338}, {"text": "crianças", "start": 137.351, "end": 137.763}, {"text": "amanhã", "start": 137.775, "end": 138.2}, {"text": "o", "start": 138.516, "end": 138.576}, {"text": "que", "start": 138.588, "end": 138.746}, {"text": "você", "start": 138.758, "end": 138.989}, {"text": "faria", "start": 139.001, "end": 139.329}, {"text": "primeiro", "start": 139.341, "end": 139.741}, {"text": "por", "start": 139.753, "end": 139.911}, {"text": "eles", "start": 139.923, "end": 140.324}, {"text": "Comenta", "start": 141.16, "end": 141.742}]}]}