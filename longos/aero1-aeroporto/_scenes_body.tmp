function titleOverlay(t) {
  if (t > 8) return '';
  const k = back(prog(t, 0, 0.3)), out = 1 - prog(t, 7.6, 8);
  return G(`translate(960,860) scale(${k * out})`, R(-620, -80, 1240, 160, 40, 'rgba(26,18,16,0.92)', 0) + T(0, -22, '30 DIAS PRESO NO AEROPORTO', 50, '#FFFFFF') + T(0, 44, 'PARTE 1', 60, '#FF6A6A'));
}
function ctaOverlay(t) {
  const a = TL.lines[71].start - 0.1;
  if (t < a) return '';
  const k = back(prog(t, a, a + 0.35));
  return G(`translate(960,170) scale(${k})`, R(-640, -110, 1280, 220, 40, 'rgba(26,18,16,0.94)', 0) + T(0, -36, 'VOCÊ ENTRARIA', 52, '#FFFFFF') + T(0, 48, 'NESSE AVIÃO?', 70, '#FFE14D'));
}
