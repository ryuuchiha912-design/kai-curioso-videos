// ================= LONGO 3 — "E se a sua FELICIDADE dobrasse todo dia?" =================
BG_NAMES.push('velorio', 'metro', 'ruaCidade');
for (const n of ['velorio', 'metro', 'ruaCidade']) { const im = document.createElement('img'); im.src = 'bg/' + n + '.png'; im.style.cssText = 'position:absolute;left:-192px;top:-108px;width:2304px;height:1296px;display:none;filter:blur(1.1px) saturate(1.12)'; BGI.appendChild(im); BGIMG[n] = im; }
const DAVI = xt({ skin: '#8A5A3A', shirt: '#E0B13A', hair: 'afro', hairCol: '#1B1716', iris: '#4A2E1A' });
const AVO = xt({ skin: '#EAC3A0', shirt: '#8E5A9A', inner: '#F4EAD8', stripe: '#6E3A7A', hair: 'bun', hairCol: '#E6E2EA', old: true, specs: '#B58A4A', iris: '#6A4A3A', skirt: '#4A3A5A', pants: '#EAC3A0', legX: 30 });
const CAIXA2 = xt({ skin: '#C88F66', shirt: '#3E9B4A', apron: '#E04B3C', hair: 'curly', hairCol: '#2A1C14', iris: '#5A3A22', earring: '#F2B636', skirt: '#2E3442', pants: '#C88F66' });
const APRES = xt({ skin: '#F1C7A0', shirt: '#7A2E3A', tie: '#F2B636', hair: 'side', hairCol: '#2A211C', iris: '#3A4A6A', legX: 70 });
const LUCIA_P = Object.assign({}, LUCIA, { shirt: '#2A2A33', stripe: '#1A1A20', inner: '#3A3A44' });
const LUTO1 = xt({ skin: '#D9A47A', shirt: '#22222A', hair: 'wavy', hairCol: '#2A1C14', iris: '#5A3A22', skirt: '#22222A', pants: '#D9A47A' });
const LUTO2 = xt({ skin: '#F1C7A0', shirt: '#22222A', hair: 'buzz', hairCol: '#5A5048', iris: '#3A4A6A', old: true });
const LUTO3 = xt({ skin: '#C88F66', shirt: '#2A2A36', hair: 'pony', hairCol: '#1B1716', iris: '#4A3A2A', earring: '#C4C4CC' });
const AGE = 25;
const NEO25 = (o) => NEOp(AGE, o);
const wg = (L, re, n = 0) => { const ws = TL.lines[L].words; let c = 0; for (const w of ws) if (re.test(w.text.toLowerCase())) { if (c === n) return w.start; c++; } return TL.lines[L].start; };
const at = (L, re, n = 0, pre = 0.25) => wg(L, re, n) - TL.lines[L].start - pre;   // tempo local da palavra
// ---------- medidor de felicidade
const FE = [];
const setF = (L, re, v, n = 0) => FE.push({ t: wg(L, re, n), v });
const setL = (L, v) => FE.push({ t: TL.lines[L].start, v });
setF(0, /^cem/, 100); setF(3, /duzentos/, 200); setF(6, /quatrocentos/, 400); setF(9, /oitocentos/, 800); setF(10, /^mil/, 1600); setF(13, /^três/, 3200);
setF(18, /^seis/, 6400); setL(22, 12800); setL(26, 25600); setF(28, /cinquenta/, 51200); setL(31, 102400); setL(36, 204800); setF(47, /quatrocentos/, 409600);
setF(51, /^cem/, 100000); setF(51, /^dez/, 10000); setF(51, /^mil/, 1000); setF(51, /^cem/, 100, 1); setF(52, /zero/, 0);
setF(61, /risada/, 30); setF(64, /oitenta/, 80); setF(64, /trinta/, 30); setF(65, /feliz/, 100);
FE.sort((a, b) => a.t - b.t);
function felAt(T) {
  let prev = 100, cur = null;
  for (const e of FE) { if (e.t > T) break; prev = cur === null ? e.v : cur; cur = e.v; }
  if (cur === null) return 0;
  const last = [...FE].reverse().find(e => e.t <= T), k = eout(prog(T, last.t, last.t + 0.7));
  if (prev > 0 && cur > 0) return prev * Math.pow(cur / prev, k);
  return lerp(prev, cur, k);
}
const fmt = (v) => Math.round(v).toLocaleString('pt-BR') + '%';
const felCol = (v) => v <= 100 ? '#2E9E5B' : v <= 1600 ? '#E8A21A' : v <= 25600 ? '#FF6A1A' : '#E0245E';
const DAYS = [[2, '1'], [3, '2'], [6, '3'], [9, '4'], [10, '5'], [13, '6'], [18, '7'], [22, '8'], [26, '9'], [28, '10'], [31, '11'], [36, '12'], [47, '13'], [56, '14'], [64, 'HOJE']];
function dayLbl(T) { let d = ''; for (const [L, v] of DAYS) if (T >= TL.lines[L].start - 0.15) d = v; return d; }
function meterPill(x, y, v, t, label = 'FELICIDADE', col = null) {
  const c = col || felCol(v), f = clamp(v / 100), big = v > 100 ? Math.min(1, Math.log10(v / 100) / 3.6) : 0;
  const sh = v >= 102400 ? [Math.sin(t * 53) * 3, Math.cos(t * 47) * 3] : [0, 0];
  const glow = big > 0 ? R(-6, -6, 532, 86, 32, c, 0, `opacity="${0.25 + 0.25 * Math.sin(t * 8)}"`) : '';
  return G(`translate(${x + sh[0]},${y + sh[1]})`, glow + R(0, 0, 520, 74, 26, '#1A1210', 6) + (f > 0 ? R(7, 7, Math.max(40, 506 * f), 60, 20, c, 0) : '') + T(260, 49, `${label} ${fmt(v)}`, v >= 100000 ? 34 : 38, '#FFFFFF', 8));
}
let LASTF = null;
function levelHud(i, t) {
  if (i < 2 || i > 68 || (i >= 50 && i <= 52)) return '';
  const d = dayLbl(t), v = felAt(t);
  let g = '';
  if (d) g += G('translate(70,62)', R(0, 0, d === 'HOJE' ? 190 : 210, 74, 26, '#1A1210', 6) + T(d === 'HOJE' ? 95 : 105, 49, d === 'HOJE' ? 'HOJE' : `DIA ${d}`, 44, '#FFFFFF'));
  const last = [...FE].reverse().find(e => e.t <= t), k = last ? 1 + 0.18 * (1 - prog(t, last.t, last.t + 0.45)) : 1;
  g += G(`translate(${d ? 296 : 70},62)`, G(`translate(260,37) scale(${k}) translate(-260,-37)`, meterPill(0, 0, v, t)));
  if (i === 68 && t > wg(68, /saudade/) - 0.1) g += G(`translate(296,150) scale(${pop1(t, wg(68, /saudade/) - 0.1)})`, meterPill(0, 0, 100, t, 'SAUDADE', '#3F86CF'));
  return g;
}
// ---------- objetos 2D
function meterBig(x, y, s, v, t, label = 'FELICIDADE', col = null) {
  const c = col || felCol(v);
  return G(`translate(${x},${y}) scale(${s})`, R(-420, -110, 840, 220, 50, '#1A1210', 9) + R(-404, -94, 808 * clamp(v / 100) || 0, 188, 40, c, 0) + T(0, -26, label, 44, '#FFFFFF', 8) + T(0, 64, fmt(v), 92, '#FFE14D', 12));
}
function confetti(t, n = 30, seed = 5) { let g = ''; const r = rng(seed); const cols = ['#FFE14D', '#FF6B9A', '#7FE3FF', '#7BE38A', '#FF9A3A']; for (let i = 0; i < n; i++) { const x = r() * 1920, sp = 140 + r() * 180, y = ((r() * 1300 + t * sp) % 1300) - 150, a = t * 200 * (r() - 0.5) + i * 40; g += G(`translate(${x + Math.sin(t * 2 + i) * 30},${y}) rotate(${a})`, R(-12, -6, 24, 12, 3, cols[i % 5], 0)); } return g; }
function haha(t, x, y, n = 4, col = '#FFE14D') { let g = ''; for (let i = 0; i < n; i++) { const k = ((t * 0.5 + i / n) % 1); g += G(`translate(${x + Math.sin(i * 2.3) * 160 + (i % 2 ? 60 : -60)},${y - k * 260}) rotate(${i % 2 ? 8 : -8}) scale(${0.7 + 0.4 * Math.sin(k * 3)})`, `<g opacity="${1 - k}">` + T(0, 0, 'HA', 60, col, 10) + '</g>'); } return g; }
function car(x, y, s, col, flip = 1, drv = null) { let g = R(-260, -90, 520, 110, 40, col, 7) + P('M-170,-90 L-120,-170 L110,-170 L170,-90Z', col, 7) + P('M-150,-96 L-110,-158 L-10,-158 L-10,-96Z', '#BFE3F5', 5) + P('M10,-96 L10,-158 L100,-158 L150,-96Z', '#BFE3F5', 5) + C(-160, 22, 46, '#2A2A33', 7) + C(160, 22, 46, '#2A2A33', 7) + C(-160, 22, 18, '#9AA3AD', 0) + C(160, 22, 18, '#9AA3AD', 0) + E(240, -40, 18, 12, '#FFE9A0', 4); if (drv) g += G('translate(60,-110) scale(0.26)', drv); return G(`translate(${x},${y}) scale(${s * flip},${s})`, g); }
function gum(x, y, s) { return G(`translate(${x},${y}) scale(${s})`, P('M-40,0 Q-30,-30 0,-24 Q36,-34 44,0 Q20,14 0,8 Q-20,16 -40,0Z', '#FF8FC0', 6) + P('M0,-24 Q6,-80 2,-120', 'none', 5) + C(2, -124, 8, '#FF8FC0', 4)); }
function wallet(x, y, s, open = 0) { return G(`translate(${x},${y}) scale(${s}) rotate(-8)`, R(-90, -60, 180, 120, 16, '#7A4A2A', 7) + Ln(-90, 0, 90, 0, '#5A3418', 6) + R(-40, -86 - open * 40, 80, 44, 6, '#7BC67E', 4)); }
function studioTv(t) { return rays(t, '#3A1F6A', '#C2577A') + G('translate(1560,150)', R(-120, -40, 240, 80, 20, '#E0245E', 6) + C(-80, 0, 12, '#FFFFFF', 0) + T(20, 14, 'AO VIVO', 36, '#FFFFFF')); }
function viralPhone(x, y, s, t, at0) { const v = Math.floor(1000000 * clamp(Math.pow(prog(t, at0, at0 + 2.4), 2.2))); return G(`translate(${x},${y}) scale(${s})`, R(-170, -320, 340, 640, 44, '#1A1A20', 8) + R(-150, -290, 300, 580, 26, '#F4F6FA', 0) + R(-150, -290, 300, 230, 26, '#2C3E66', 0) + G('translate(0,-170) scale(0.5)', head(Object.assign(neoAt(AGE), { hs: 1, expr: 'laugh' }))) + C(0, -175, 40, 'rgba(255,255,255,0.0)', 0) + T(0, 0, 'HOMEM RI SEM PARAR', 24, '#1A1210') + T(0, 40, 'NO METRÔ', 24, '#1A1210') + R(-130, 90, 260, 70, 20, '#E0245E', 0) + T(0, 136, v.toLocaleString('pt-BR'), 34, '#FFFFFF') + T(0, 190, 'visualizações', 22, '#5A6070') + heart(-90, 250, 0.35, '#E0245E') + heart(0, 250, 0.35, '#E0245E') + heart(90, 250, 0.35, '#E0245E')); }
function callScreen(x, y, s, name, t, ring = 1, sub = 'chamando…') { const sh = ring ? Math.sin(t * 40) * 5 : 0; return G(`translate(${x + sh},${y}) scale(${s})`, R(-160, -300, 320, 600, 44, '#1A1A20', 8) + R(-142, -272, 284, 544, 26, '#2C3550', 0) + C(0, -120, 70, '#F4F1EA', 0) + T(0, -100, name[0], 70, '#2C3550') + T(0, 10, name, 46, '#FFFFFF') + T(0, 56, sub, 26, '#BFC8DA') + C(-70, 190, 40, '#4CAF50', 0) + C(70, 190, 40, '#E04B3C', 0)); }
function frameAvo(x, y, s, expr = 'happy') { return G(`translate(${x},${y}) scale(${s})`, R(-150, -180, 300, 360, 14, '#8A5A33', 9) + R(-120, -150, 240, 300, 6, '#F4E6D2', 0) + clipG('<rect x="-120" y="-150" width="240" height="300"/>', G('translate(0,-10) scale(0.62)', head(Object.assign({}, AVO, { hs: 1, expr, blink: false })))) + P('M-150,-180 L-90,-180 L-150,-120Z', '#22222A', 0)); }
function searchPhone(x, y, s, t, at0) { const q = 'como ficar triste', n = Math.floor(clamp((t - at0) / 1.6) * q.length); return G(`translate(${x},${y}) scale(${s})`, R(-170, -320, 340, 640, 44, '#1A1A20', 8) + R(-150, -290, 300, 580, 26, '#F4F6FA', 0) + R(-130, -250, 260, 64, 32, '#FFFFFF', 5) + T(0, -208, q.slice(0, n) + (Math.sin(t * 8) > 0 ? '|' : ''), 26, '#1A1210') + (n >= q.length ? [0, 1, 2].map(i => R(-130, -150 + i * 90, 260, 70, 12, '#E6EAF2', 0) + Ln(-110, -125 + i * 90, 80, -125 + i * 90, '#9AA6B8', 6)).join('') : '')); }
function pizza(x, y, s) { let g = C(0, 0, 150, '#E8B66A', 8) + C(0, 0, 124, '#F2B636', 0); const r = rng(9); for (let i = 0; i < 9; i++) g += C((r() - 0.5) * 180, (r() - 0.5) * 180, 18, '#C62A2A', 4); for (let i = 0; i < 4; i++) g += Ln(0, 0, Math.cos(i * 0.785) * 150, Math.sin(i * 0.785) * 150, 'rgba(120,70,30,0.5)', 4); return G(`translate(${x},${y}) scale(${s},${s * 0.45})`, g); }
function polaAvo(x, y, s, rot) { return G(`translate(${x},${y}) rotate(${rot}) scale(${s})`, R(-170, -200, 340, 400, 10, '#FFFFFF', 7) + R(-150, -180, 300, 290, 4, '#E8C9A0', 0) + clipG('<rect x="-150" y="-180" width="300" height="290"/>', sepia(G('translate(0,-30) scale(0.55)', person(Object.assign({}, AVO, { x: 0, y: 400, s: 1, old: false, specs: null, hairCol: '#3A2418', expr: 'happy', hl: [-200, -420], hr: [180, -300] }))))) + T(0, 160, '1978', 40, '#5A4A3A')); }
function wallKnock(x, y, t, a0) { if (t < a0) return ''; const k = ((t - a0) * 2.2) % 1; return G(`translate(${x},${y}) scale(${1 + 0.2 * (1 - k)})`, star(0, 0, 90, 56, 10, '#FFE14D') + T(0, 12, 'TUM!', 42, '#C62A2A')); }
function bicycle(x, y, s) { return G(`translate(${x},${y}) scale(${s})`, C(-90, 0, 60, 'none', 8) + C(90, 0, 60, 'none', 8) + P('M-90,0 L-20,-90 L60,-90 L90,0 M-20,-90 L0,0 L60,-90 M-30,-110 L-5,-110 M60,-90 L50,-130 L80,-130', 'none', 8)); }
function candies(x, y, s) { return G(`translate(${x},${y}) scale(${s})`, candy(-50, 0, 0.9, '#E04B3C') + candy(40, 20, 0.9, '#F2B636') + candy(10, -40, 0.9, '#3F86CF')); }
const crySide = (x, y, t, s = 1) => tears(x, y, t, s);
const NEOS = (o) => NEO25(Object.assign({ s: 0.92 }, o));

const S = [];
// 0 — gancho: acorda sorrindo; aparece o número
S[0] = (t, d) => { const aC = at(0, /^cem/, 0, 0.4);
  let g = lying(Object.assign(neoAt(AGE), { hs: 1, expr: t < 1.4 ? 'sleep' : 'happy' }), 1560, 760, 0.55);
  if (t > aC) g += meterBig(820, 460, pop1(t, aC) * 1.0, felAt(TL.lines[0].start + t), t) + sparkle(1210, 360, 1.2) + sparkle(440, 560, 0.9);
  return sc('quarto', g, drift(t, d, [960, 540, 1.0], [900, 520, 1.12])); };
// 1 — vai dobrar; "você vai implorar pra ficar triste"
S[1] = (t, d) => { const aA = at(1, /amanhã/), aD = at(1, /depois/), aI = at(1, /implorar/, 0, 0.6);
  let g = rays(t, '#3A1F6A', '#FF7A1A');
  const v = t < aA ? 100 : t < aD ? lerp(100, 200, eout(prog(t, aA, aA + 0.6))) : t < aI ? lerp(200, 400, eout(prog(t, aD, aD + 0.6))) : 409600 * eout(prog(t, aI, aI + 1.2)) + 400;
  g += meterBig(960, 330, 1.0, v, t);
  if (t > aI) g += NEOS({ x: 960, y: 1180, s: 0.9, expr: 'creepy', hl: [-150, -330], hr: [150, -330] }) + bigTxt(960, 620, pop1(t, aI + 0.4), 'VOCÊ VAI IMPLORAR', 'PRA FICAR TRISTE', '#FFFFFF', '#FFE14D', 56, 74);
  return sc(null, g, drift(t, d, [960, 540, 1.0], [960, 540, 1.06])); };
// 2 — dia 1: café, ônibus, assobio
S[2] = (t, d) => { const aO = at(2, /ônibus/), aA = at(2, /assobia/);
  let g = NEOS({ x: 760, y: FY, expr: 'happy', hr: t < aO ? [130, -330] : [150, -230], smile: true });
  if (t < aO) g += mug(880, 560, 1.0, t) + sparkle(940, 470, 0.8);
  else if (t < aA) g += busSide(1450, 900, 0.9, 'NA HORA ✓', '#F2B636');
  else g += notes(t, 860, 420);
  return sc(t < aO ? 'maeCozinha' : t < aA ? 'rua' : 'escritorio', g, drift(t, d, [960, 540, 1.0], [960, 520, 1.06])); };
// 3 — dia 2: pisa no chiclete e ri
S[3] = (t, d) => { const aE = at(3, /engraçado/);
  let g = NEOS({ x: 900, y: FY, expr: t > aE ? 'laugh' : 'surprised', hl: [-160, -220], hr: [160, -220] }) + gum(1000, FY - 10, 1.0);
  if (t > aE) g += haha(t, 900, 330, 3);
  return sc('ruaCidade', g, drift(t, d, [960, 600, 1.12], [960, 560, 1.0])); };
// 4 — o chefe grita; "que bom que o senhor é sincero!"
S[4] = (t, d) => { const aR = at(4, /responde/, 0, 0.1);
  let g = pp(CHEFE, { x: 1300, y: FY, s: 0.95, sx: -1, expr: 'angry', hr: [220, -360], hl: [-140, -200] }) + NEOS({ x: 620, y: FY, expr: 'happy', smile: true, lx: 1 });
  if (t < aR + 0.2) g += say(1000, 150, 620, 'ISSO TÁ UM LIXO!!!', 52, 'right', '#FFFFFF', t, 0.3) + G(`translate(${1300 + Math.sin(t * 50) * 4},420)`, '');
  if (t > aR) g += say(160, 150, 760, 'QUE BOM QUE O SENHOR É SINCERO!', 42, 'left', '#FFF6C8', t, aR);
  return sc('escritorio', g, drift(t, d, [960, 540, 1.0], [960, 520, 1.06])); };
// 5 — o chefe não sabe se demite ou dá aumento
S[5] = (t, d) => { let g = pp(CHEFE, { x: 960, y: FY + 20, s: 1.0, expr: 'surprised', hl: [-120, -500], hr: [120, -500] });
  g += badgeB(560, 330, pop1(t, 0.6), 'DEMITIR?', '#C62A2A', '#FFFFFF', 54, -5) + badgeB(1360, 330, pop1(t, 1.3), 'AUMENTO?', '#2E9E5B', '#FFFFFF', 54, 5);
  return sc('escritorio', g, drift(t, d, [960, 520, 1.05], [960, 500, 1.15])); };
// 6 — dia 3: trânsito parado, cantando junto
S[6] = (t, d) => { const aJ = at(6, /junto/, 0, 0.6);
  let g = car(620, 900, 1.25, '#3F86CF', 1, head(Object.assign(neoAt(AGE), { hs: 1, expr: 'laugh' }))) + notes(t, 600, 560);
  g += car(1380, 940, 1.25, '#E04B3C', -1, head(Object.assign({}, xt({ skin: '#D9A47A', hair: 'buzz', hairCol: '#2A211C', stubble: true, iris: '#4A3A2A' }), { hs: 1, expr: t > aJ ? 'laugh' : 'sus' })));
  if (t > aJ) g += notes(t + 0.5, 1360, 600);
  return sc('ruaCidade', g, drift(t, d, [960, 560, 1.0], [960, 540, 1.08])); };
// 7 — Provine: rimos até 30x mais acompanhados
S[7] = (t, d) => { const aT = at(7, /trinta/, 0, 0.4), aP = at(7, /pega/, 0, 0.3);
  let g = rays(t, '#1E2A5A', '#3C5A8A') + badgeB(960, 190, pop1(t, 1.2), 'ROBERT PROVINE · PESQUISADOR DO RISO', '#FFFFFF', '#1A1210', 38, -2);
  g += G('translate(560,620)', C(0, -80, 60, '#E8E4F0', 6) + P('M-70,60 Q-70,-10 0,-10 Q70,-10 70,60Z', '#E8E4F0', 6) + T(0, 140, 'SOZINHO', 40, '#FFFFFF', 8) + T(0, 220, '1x', 70, '#FFE14D', 12));
  if (t > aT) { for (let i = 0; i < 5; i++) g += G(`translate(${1180 + (i % 3) * 140 + (i > 2 ? 70 : 0)},${560 + (i > 2 ? 110 : 0)}) scale(0.8)`, C(0, -80, 60, '#FFB86B', 6) + P('M-70,60 Q-70,-10 0,-10 Q70,-10 70,60Z', '#FFB86B', 6)); g += G(`translate(1320,880) scale(${pop1(t, aT)})`, T(0, 0, 'ATÉ 30x MAIS', 70, '#FFE14D', 12)); }
  if (t > aP) g += haha(t, 1320, 420, 4);
  return sc(null, g, [960, 540, 1.0]); };
// 8 — a sua risada pegando em todo mundo
S[8] = (t, d) => { let g = '';
  [[COLEGA1, 380], [COLEGA2, 640], [MOCA, 1280], [GERENTE, 1540]].forEach(([c, x], i) => { g += pp(c, { x, y: FY + 10, s: 0.82, sx: x > 960 ? -1 : 1, expr: t > 0.4 + i * 0.3 ? 'laugh' : 'neutral' }); });
  g += NEOS({ x: 960, y: FY, s: 0.95, expr: 'laugh', hl: [-150, -330], hr: [150, -330] }) + haha(t, 960, 380, 6);
  return sc('escritorio', g, drift(t, d, [960, 540, 1.08], [960, 540, 1.0])); };
// 9 — dia 4: mercado, a moça do caixa, a fila inteira ri
S[9] = (t, d) => { const aP = at(9, /piada/), aR = at(9, /ri\.?$/, 0, 0.2), aF = at(9, /inteira/, 0, 0.4);
  let g = pp(CAIXA2, { x: 1300, y: FY, s: 0.92, sx: -1, expr: t > aR ? 'laugh' : 'tired' }) + NEOS({ x: 820, y: FY, expr: 'happy', smile: true, hr: [140, -330], lx: 1 });
  if (t > aF) g += pp(LUTO2, { x: 330, y: FY + 20, s: 0.78, shirt: '#3E6A8A', expr: 'laugh' }) + pp(COLEGA2, { x: 520, y: FY + 30, s: 0.78, expr: 'laugh' }) + haha(t, 700, 360, 5);
  if (t > aP && t < aR) g += say(380, 170, 560, 'SABE O QUE O PATO DISSE?', 38, 'left', '#FFF6C8', t, aP);
  return sc('mercado', g, drift(t, d, [960, 540, 1.0], [960, 520, 1.06])); };
// 10 — dia 5: festa no cérebro; sem preguiça, medo, sono
S[10] = (t, d) => { const ks = [/preguiça/, /medo/, /sono/].map(r => at(10, r, 0, 0.3)), aF = at(10, /festa/);
