  let g = rays(t, '#1E2A5A', '#3C5A8A') + bigTxt(960, 330, pop1(t, 1.0), 'A TRISTEZA', 'NÃO É UM DEFEITO', '#FFFFFF', '#7FC8FF', 64, 80);
  if (t > aF) g += badgeB(960, 700, pop1(t, aF), 'ELA TEM UMA FUNÇÃO', '#FFFFFF', '#1A1210', 56);
  return sc(null, g, [960, 540, 1.0]); };
// 45 — avisa que perdeu algo; aproxima as pessoas
S[45] = (t, d) => { const aA = at(45, /aproximarem/, 0, 0.4);
  let g = rays(t, '#1E2A5A', '#3C5A8A') + G('translate(560,520)', C(0, 0, 180, '#FFFFFF', 9) + T(0, -10, '⚠', 10, '#000') + P('M0,-110 L100,70 L-100,70Z', '#FFE14D', 9) + T(0, 50, '!', 110, '#1A1210')) + T(560, 800, 'TE AVISA', 52, '#FFFFFF', 10);
  if (t > aA) g += G(`translate(1360,560) scale(${pop1(t, aA)})`, G('translate(-90,0) scale(0.5)', person(Object.assign({}, LUTO1, { x: 0, y: 300, s: 1, shirt: '#E07B9A', expr: 'sad', hr: [200, -300] }))) + G('translate(90,0) scale(0.5)', person(Object.assign({}, DAVI, { x: 0, y: 300, s: 1, sx: -1, expr: 'worried', hr: [200, -300] }))) + heart(0, -260, 1.0)) + T(1360, 800, 'APROXIMA AS PESSOAS', 46, '#FFFFFF', 10);
  return sc(null, g, [960, 540, 1.0]); };
// 46 — sem tristeza você não consola ninguém
S[46] = (t, d) => { let g = NEOS({ x: 960, y: FY + 260, s: 1.0, expr: 'creepy' }) + dark(0.25) + bigTxt(960, 240, pop1(t, 0.4), 'SEM TRISTEZA, VOCÊ NÃO', 'CONSEGUE CONSOLAR NINGUÉM', '#FFFFFF', '#FF8A8A', 48, 58);
  return sc('quartoNoite', g, drift(t, d, [960, 540, 1.0], [960, 520, 1.08])); };
// 47 — dia 13: no chão do quarto, rindo e sem conseguir parar
S[47] = (t, d) => { let g = lying(Object.assign(neoAt(AGE), { hs: 1, expr: 'laugh', hrot: Math.sin(t * 14) * 6 }), 960, 800, 0.85) + haha(t, 960, 520, 6, '#FF8A8A') + tears(960, 640, t, 0.7);
  return sc('quartoNoite', g, drift(t, d, [960, 600, 1.0], [960, 640, 1.16])); };
// 48 — você fala com o número
S[48] = (t, d) => { const aN = at(48, /número/, 0, 0.4);
  let g = lying(Object.assign(neoAt(AGE), { hs: 1, expr: 'laugh' }), 700, 860, 0.7) + (t > aN ? meterBig(1250, 400, pop1(t, aN), 409600, t) : '');
  return sc('quartoNoite', g, drift(t, d, [960, 560, 1.0], [1050, 520, 1.08])); };
// 49 — "eu não quero mais. pode levar tudo."
S[49] = (t, d) => { let g = NEOS({ x: 960, y: FY + 380, s: 1.6, expr: 'sad' }) + tears(960, 330, t, 1.2) + meterBig(420, 300, 0.55, 409600, t);
  g += say(1220, 300, 560, 'PODE LEVAR TUDO.', 46, 'left', '#FFFFFF', t, at(49, /pode/, 0, 0.1));
  return sc('quartoNoite', g, drift(t, d, [960, 420, 1.0], [960, 380, 1.12])); };
// 50 — o número começa a cair
S[50] = (t, d) => { let g = dark(0.4) + meterBig(960, 480, 1.0, 409600 * Math.pow(0.25, prog(t, 0.6, 1.8)), t);
  return sc('quartoNoite', g, [960, 540, 1.0]); };
// 51 — cem mil, dez mil, mil, cem
S[51] = (t, d) => { let g = dark(0.55) + meterBig(960, 480, 1.0, felAt(TL.lines[51].start + t), t);
  return sc('quartoNoite', g, drift(t, d, [960, 540, 1.0], [960, 540, 1.1])); };
// 52 — zero
S[52] = (t, d) => { let g = R(-200, -200, 2320, 1480, 0, '#08070C', 0) + meterBig(960, 480, 1.0, 0, t, 'FELICIDADE', '#3A3F4B');
  return sc(null, g, [960, 540, 1.0]); };
// 53 — finalmente… dói
S[53] = (t, d) => { const aD = at(53, /dói/, 0, 0.3);
  let g = NEOS({ x: 960, y: FY + 380, s: 1.6, expr: t > aD ? 'sad' : 'neutral' }) + (t > aD ? tears(960, 330, t, 1.3) : '');
  return sc('quartoNoite', g, drift(t, d, [960, 420, 1.0], [960, 380, 1.14])); };
// 54 — dói tudo: a avó, o Davi, a voz da mãe
S[54] = (t, d) => { const ks = [/avó/, /davi/, /voz/].map(r => at(54, r, 0, 0.3));
  let g = dark(0.3);
  if (t > ks[0]) g += memPanel(120, 180, 520, 560, pop1(t, ks[0]), sepia(R(0, 0, 520, 560, 0, '#E8C9A0', 0) + G('translate(260,300) scale(0.9)', head(Object.assign({}, AVO, { hs: 1, expr: 'happy', blink: false })))), 5, -4);
  if (t > ks[1]) g += memPanel(700, 180, 520, 560, pop1(t, ks[1]), R(0, 0, 520, 560, 0, '#2C3550', 0) + G('translate(260,300) scale(0.9)', head(Object.assign({}, DAVI, { hs: 1, expr: 'sad' }))), 6, 3);
  if (t > ks[2]) g += memPanel(1280, 180, 520, 560, pop1(t, ks[2]), R(0, 0, 520, 560, 0, '#3A2A40', 0) + G('translate(260,300) scale(0.9)', head(Object.assign({}, LUCIA, { hs: 1, expr: 'surprised' }))) + T(260, 520, 'VOCÊ TÁ RINDO?', 40, '#FFE9F0', 8), 7, -3);
  return sc('quartoNoite', g, [960, 540, 1.0]); };
// 55 — chora a noite inteira
S[55] = (t, d) => { let g = sitPerson(neoAt(AGE), 960, 820, 0.95, { expr: 'sad' }) + tears(960, 420, t, 1.0);
  g += G('translate(1600,220)', clockBig(0, 0, 70, -Math.PI / 2 + t * 0.6, -Math.PI / 2 + t * 4));
  return sc('quartoNoite', g, drift(t, d, [960, 540, 1.0], [960, 500, 1.1])); };
// 56 — dia 14: na porta da mãe, olhos inchados
S[56] = (t, d) => { let g = NEOS({ x: 700, y: FY, expr: 'sad', lx: 1 }) + tears(700, 440, t * 0.5, 0.5) + G(`translate(1000,380) scale(${pop1(t, 1.0)})`, T(0, 0, 'TOC TOC', 50, '#FFFFFF', 10));
  g += G('translate(1600,220)', clockBig(0, 0, 70, -Math.PI / 2 + 3.67, -Math.PI / 2) + T(0, 120, '07:00', 40, '#FFFFFF', 8));
  return sc('ruaCidade', g, drift(t, d, [960, 540, 1.0], [960, 520, 1.06])); };
// 57 — ela abre a porta; não precisa de palavra
S[57] = (t, d) => { let g = pp(LUCIA, { x: 1200, y: FY, s: 0.95, sx: -1, expr: t > 2.2 ? 'sad' : 'surprised' }) + NEOS({ x: 700, y: FY, expr: 'sad', lx: 1 }) + tears(700, 440, t, 0.7);
  return sc('maeSala', g, drift(t, d, [960, 540, 1.0], [960, 500, 1.12])); };
// 58 — abraço triste, juntos
S[58] = (t, d) => { let g = NEOS({ x: 900, y: FY, expr: 'sad', hl: [40, -200], hr: [190, -240], lx: 1 }) + pp(LUCIA, { x: 1010, y: FY, s: 0.95, sx: -1, expr: 'sad', hr: [-190, -240], hl: [-40, -200] }) + tears(880, 440, t, 0.6) + tears(1030, 440, t + 0.3, 0.6);
  return sc('maeSala', g, drift(t, d, [960, 540, 1.0], [960, 480, 1.16])); };
// 59 — e também o mais bonito
S[59] = (t, d) => { let g = NEOS({ x: 900, y: FY, expr: 'sad', hl: [40, -200], hr: [190, -240], lx: 1 }) + pp(LUCIA, { x: 1010, y: FY, s: 0.95, sx: -1, expr: 'happy', hr: [-190, -240], hl: [-40, -200] });
  for (let i = 0; i < 5; i++) { const k = ((t * 0.45 + i / 5) % 1); g += heart(800 + i * 80, 560 - k * 360, 0.9 * (1 - k)); }
  return sc('maeSala', g, drift(t, d, [960, 480, 1.16], [960, 500, 1.22])); };
// 60 — o Davi: pede desculpa e só ouve
S[60] = (t, d) => { const aD = at(60, /desculpa/), aO = at(60, /ouvindo/, 1, 0.4);
  let g = sitPerson(DAVI, 1250, 820, 0.88, { expr: 'sad', hr: [-80, -250] }) + sitPerson(neoAt(AGE), 700, 820, 0.88, { expr: 'worried', lx: 1 });
  if (t > aD && t < aO) g += say(260, 160, 480, 'ME DESCULPA.', 46, 'left', '#FFFFFF', t, aD);
  if (t > aO) g += badgeB(960, 200, pop1(t, aO), 'SÓ OUVINDO', '#FFFFFF', '#1A1210', 52);
  return sc('sala', g, drift(t, d, [960, 540, 1.0], [960, 520, 1.06])); };
// 61 — uma risada pequena, cansada, de verdade
S[61] = (t, d) => { const aV = at(61, /verdade/, 0, 0.4);
  let g = sitPerson(DAVI, 1250, 820, 0.88, { expr: 'happy', hr: [-80, -250] }) + sitPerson(neoAt(AGE), 700, 820, 0.88, { expr: 'neutral', lx: 1 }) + T(1420, 380, 'ha.', 46, '#FFFFFF', 10);
  if (t > aV) g += badgeB(1250, 240, pop1(t, aV), 'DE VERDADE', '#2E9E5B', '#FFFFFF', 44);
  return sc('sala', g, drift(t, d, [960, 540, 1.0], [1150, 500, 1.14])); };
// 62 — vale mais do que um milhão por cento
S[62] = (t, d) => { const aM = at(62, /milhão/, 0, 0.4);
  let g = rays(t, '#C9708A', '#F7C99A') + G('translate(960,330)', T(0, 0, '1.000.000%', 110, '#FFFFFF', 14) + (t > aM ? Ln(-360, -30, 360, -30, '#C62A2A', 18) : ''));
  if (t > aM) g += badgeB(960, 640, pop1(t, aM + 0.3), 'ESSA RISADA VALE MAIS', '#FFFFFF', '#1A1210', 52);
  return sc(null, g, [960, 540, 1.0]); };
// 63 — pizza e conversa até a noite
S[63] = (t, d) => { let g = sitPerson(DAVI, 1250, 820, 0.88, { expr: 'laugh', hr: [-100, -230] }) + sitPerson(neoAt(AGE), 700, 820, 0.88, { expr: 'happy', hl: [80, -250], lx: 1 }) + pizza(960, 720, 0.8);
  return sc(t > d * 0.6 ? 'quartoNoite' : 'sala', g, drift(t, d, [960, 540, 1.0], [960, 520, 1.08])); };
// 64 — hoje: o medidor nunca passou de 100 (80, 30)
S[64] = (t, d) => { const aO = at(64, /oitenta/), aT = at(64, /trinta/);
  let g = NEOS({ x: 960, y: FY + 30, s: 1.0, expr: t > aT ? 'neutral' : t > aO ? 'happy' : 'neutral', smile: t > aO && t < aT }) + meterBig(960, 230, 0.8, felAt(TL.lines[64].start + t), t);
  return sc('quarto', g, drift(t, d, [960, 540, 1.0], [960, 520, 1.06])); };
// 65 — feliz por um motivo; triste também
S[65] = (t, d) => { const aT = at(65, /triste/, 0, 0.3);
  let g = rays(t, '#3B4F8A', '#F0A070') + bigTxt(560, 420, pop1(t, 1.2), 'FELIZ', 'POR UM MOTIVO', '#FFFFFF', '#FFE14D', 76, 60);
  if (t > aT) g += bigTxt(1360, 420, pop1(t, aT), 'TRISTE', 'TAMBÉM', '#FFFFFF', '#7FC8FF', 76, 60);
  g += NEOS({ x: 960, y: 1200, s: 0.9, expr: 'happy', smile: true });
  return sc(null, g, [960, 540, 1.0]); };
// 66 — semana passada: fotos antigas da avó
S[66] = (t, d) => { let g = sitPerson(LUCIA, 1180, 820, 0.88, { expr: 'neutral', hr: [-100, -250] }) + sitPerson(neoAt(AGE), 740, 820, 0.88, { expr: 'neutral', hl: [100, -250], lx: 1 }) + G('translate(960,640) rotate(-6)', R(-160, -100, 320, 200, 10, '#8E5A9A', 7) + R(-140, -80, 120, 160, 4, '#F4EAD8', 0) + R(20, -80, 120, 160, 4, '#F4EAD8', 0));
  return sc('maeSalaNoite', g, drift(t, d, [960, 540, 1.0], [960, 560, 1.1])); };
// 67 — choraram e riram da foto dela dançando em 1978
S[67] = (t, d) => { const aR = at(67, /riram/), aF = at(67, /foto/);
  let g = sitPerson(LUCIA, 1180, 820, 0.88, { expr: t > aR ? 'laugh' : 'sad', hr: [-100, -250] }) + sitPerson(neoAt(AGE), 740, 820, 0.88, { expr: t > aR ? 'laugh' : 'sad', hl: [100, -250], lx: 1 });
  if (t < aR) g += tears(1180, 440, t, 0.5) + tears(740, 440, t, 0.5);
  if (t > aF) g += polaAvo(960, 360, 0.9 * pop1(t, aF), -4);
  return sc('maeSalaNoite', g, drift(t, d, [960, 540, 1.0], [960, 500, 1.08])); };
// 68 — felicidade e saudade, as duas em 100%
S[68] = (t, d) => { const aS = at(68, /saudade/, 0, 0.1);
  let g = rays(t, '#3B4F8A', '#F0A070') + meterBig(960, 330, 0.9, 100, t);
  if (t > aS) g += meterBig(960, 620, 0.9 * pop1(t, aS), 100, t, 'SAUDADE', '#3F86CF');
  for (let i = 0; i < 5; i++) { const k = ((t * 0.4 + i / 5) % 1); g += heart(560 + i * 200, 1000 - k * 260, 0.8 * (1 - k)); }
  return sc(null, g, [960, 540, 1.0]); };
// 69 — CTA
S[69] = (t, d) => { let g = rays(t, '#3B4F8A', '#F0A070') + pp(LUCIA, { x: 1150, y: 1010, s: 0.9, sx: -1, expr: 'happy' }) + NEO25({ x: 780, y: 1010, s: 0.9, expr: 'happy', smile: true });
  for (let i = 0; i < 5; i++) { const k = ((t * 0.45 + i / 5) % 1); g += heart(880 + i * 40, 560 - k * 300, 0.8 * (1 - k)); }
  return sc(null, g, [960, 540, 1.0]); };

function titleOverlay(t) {
  if (t > 9) return '';
  const k = back(prog(t, 0, 0.3)), out = 1 - prog(t, 8.6, 9);
  return G(`translate(960,860) scale(${k * out})`, R(-640, -80, 1280, 160, 40, 'rgba(26,18,16,0.92)', 0) + T(0, -22, 'E SE A SUA FELICIDADE', 50, '#FFFFFF') + T(0, 44, 'DOBRASSE TODO DIA?', 60, '#FFE14D'));
}
function ctaOverlay(t) {
  const a = TL.lines[69].start - 0.1;
  if (t < a) return '';
  const k = back(prog(t, a, a + 0.35));
  return G(`translate(960,170) scale(${k})`, R(-720, -110, 1440, 220, 40, 'rgba(26,18,16,0.94)', 0) + T(0, -36, 'VOCÊ TROCARIA A SUA TRISTEZA', 50, '#FFFFFF') + T(0, 48, 'POR FELICIDADE INFINITA?', 64, '#FFE14D'));
}
