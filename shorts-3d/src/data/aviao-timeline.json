{"total": 45.975, "lines": [{"cap": "Se fumar no avião é proibido… por que o banheiro tem um cinzeiro?", "start": 0.36, "end": 3.721, "audio_at": 0.3, "dur": 3.6008750000000003, "words": [{"text": "Se", "start": 0.36, "end": 0.572}, {"text": "fumar", "start": 0.584, "end": 0.938}, {"text": "no", "start": 0.95, "end": 1.02}, {"text": "avião", "start": 1.032, "end": 1.374}, {"text": "é", "start": 1.386, "end": 1.433}, {"text": "proibido", "start": 1.445, "end": 1.964}, {"text": "por", "start": 2.188, "end": 2.353}, {"text": "que", "start": 2.365, "end": 2.518}, {"text": "o", "start": 2.53, "end": 2.577}, {"text": "banheiro", "start": 2.589, "end": 2.978}, {"text": "tem", "start": 2.99, "end": 3.119}, {"text": "um", "start": 3.131, "end": 3.202}, {"text": "cinzeiro", "start": 3.214, "end": 3.721}]}, {"cap": "Não é esquecimento. É obrigatório.", "start": 4.191, "end": 7.03, "audio_at": 4.131, "dur": 3.079167, "words": [{"text": "Não", "start": 4.191, "end": 4.474}, {"text": "é", "start": 4.486, "end": 4.604}, {"text": "esquecimento", "start": 4.615, "end": 5.358}, {"text": "É", "start": 6.169, "end": 6.299}, {"text": "obrigatório", "start": 6.311, "end": 7.03}]}, {"cap": "As regras de segurança da aviação exigem um cinzeiro na porta do banheiro.", "start": 7.45, "end": 11.259, "audio_at": 7.39, "dur": 4.0489999999999995, "words": [{"text": "As", "start": 7.45, "end": 7.639}, {"text": "regras", "start": 7.651, "end": 8.051}, {"text": "de", "start": 8.063, "end": 8.146}, {"text": "segurança", "start": 8.158, "end": 8.712}, {"text": "da", "start": 8.724, "end": 8.794}, {"text": "aviação", "start": 8.806, "end": 9.254}, {"text": "exigem", "start": 9.266, "end": 9.679}, {"text": "um", "start": 9.691, "end": 9.75}, {"text": "cinzeiro", "start": 9.761, "end": 10.257}, {"text": "na", "start": 10.268, "end": 10.41}, {"text": "porta", "start": 10.422, "end": 10.74}, {"text": "do", "start": 10.752, "end": 10.834}, {"text": "banheiro", "start": 10.846, "end": 11.259}]}, {"cap": "O motivo? Sempre tem alguém que fuma escondido.", "start": 11.729, "end": 15.016, "audio_at": 11.669, "dur": 3.52725, "words": [{"text": "O", "start": 11.729, "end": 11.812}, {"text": "motivo", "start": 11.823, "end": 12.342}, {"text": "Sempre", "start": 13.153, "end": 13.613}, {"text": "tem", "start": 13.625, "end": 13.755}, {"text": "alguém", "start": 13.766, "end": 14.085}, {"text": "que", "start": 14.097, "end": 14.191}, {"text": "fuma", "start": 14.203, "end": 14.427}, {"text": "escondido", "start": 14.438, "end": 15.016}]}, {"cap": "E, sem cinzeiro, onde essa pessoa apaga o cigarro?", "start": 15.436, "end": 18.573, "audio_at": 15.376, "dur": 3.376792, "words": [{"text": "E", "start": 15.436, "end": 15.66}, {"text": "sem", "start": 15.896, "end": 16.167}, {"text": "cinzeiro", "start": 16.179, "end": 16.698}, {"text": "onde", "start": 16.922, "end": 17.182}, {"text": "essa", "start": 17.193, "end": 17.382}, {"text": "pessoa", "start": 17.394, "end": 17.783}, {"text": "apaga", "start": 17.795, "end": 18.042}, {"text": "o", "start": 18.054, "end": 18.078}, {"text": "cigarro", "start": 18.09, "end": 18.573}]}, {"cap": "No lixo do banheiro. Cheio de papel.", "start": 18.993, "end": 21.832, "audio_at": 18.933, "dur": 3.079167, "words": [{"text": "No", "start": 18.993, "end": 19.158}, {"text": "lixo", "start": 19.17, "end": 19.512}, {"text": "do", "start": 19.524, "end": 19.63}, {"text": "banheiro", "start": 19.642, "end": 20.102}, {"text": "Cheio", "start": 20.912, "end": 21.302}, {"text": "de", "start": 21.313, "end": 21.408}, {"text": "papel.", "start": 21.42, "end": 21.832}]}, {"cap": "Em 1973, um avião brasileiro, do Rio para Paris, pegou fogo bem no banheiro.", "start": 22.452, "end": 28.349, "audio_at": 22.392, "dur": 6.1362499999999995, "words": [{"text": "Em 1973", "start": 22.452, "end": 24.115}, {"text": "um", "start": 24.445, "end": 24.587}, {"text": "avião", "start": 24.599, "end": 24.882}, {"text": "brasileiro", "start": 24.893, "end": 25.4}, {"text": "do", "start": 25.66, "end": 25.837}, {"text": "Rio", "start": 25.849, "end": 26.084}, {"text": "para", "start": 26.096, "end": 26.261}, {"text": "Paris", "start": 26.273, "end": 26.721}, {"text": "pegou", "start": 26.945, "end": 27.228}, {"text": "fogo", "start": 27.24, "end": 27.582}, {"text": "bem", "start": 27.594, "end": 27.818}, {"text": "no", "start": 27.83, "end": 27.924}, {"text": "banheiro", "start": 27.936, "end": 28.349}]}, {"cap": "A suspeita mais forte: um cigarro jogado no lixo.", "start": 28.769, "end": 31.705, "audio_at": 28.709, "dur": 3.176333, "words": [{"text": "A", "start": 28.769, "end": 28.863}, {"text": "suspeita", "start": 28.875, "end": 29.394}, {"text": "mais", "start": 29.405, "end": 29.57}, {"text": "forte", "start": 29.582, "end": 29.983}, {"text": "um", "start": 30.254, "end": 30.36}, {"text": "cigarro", "start": 30.372, "end": 30.809}, {"text": "jogado", "start": 30.82, "end": 31.245}, {"text": "no", "start": 31.257, "end": 31.327}, {"text": "lixo", "start": 31.339, "end": 31.705}]}, {"cap": "Mais de cem pessoas morreram.", "start": 32.225, "end": 33.935, "audio_at": 32.165, "dur": 1.949917, "words": [{"text": "Mais", "start": 32.225, "end": 32.531}, {"text": "de", "start": 32.543, "end": 32.661}, {"text": "cem", "start": 32.673, "end": 32.932}, {"text": "pessoas", "start": 32.944, "end": 33.404}, {"text": "morreram", "start": 33.416, "end": 33.935}]}, {"cap": "Por isso o cinzeiro continua lá.", "start": 34.705, "end": 36.509, "audio_at": 34.645, "dur": 2.04425, "words": [{"text": "Por", "start": 34.705, "end": 34.893}, {"text": "isso", "start": 34.905, "end": 35.153}, {"text": "o", "start": 35.165, "end": 35.2}, {"text": "cinzeiro", "start": 35.212, "end": 35.695}, {"text": "continua", "start": 35.707, "end": 36.226}, {"text": "lá", "start": 36.238, "end": 36.509}]}, {"cap": "Ninguém deveria usar… mas, se alguém usar, ele pode salvar o avião.", "start": 36.929, "end": 41.21, "audio_at": 36.869, "dur": 4.520665999999999, "words": [{"text": "Ninguém", "start": 36.929, "end": 37.377}, {"text": "deveria", "start": 37.389, "end": 37.719}, {"text": "usar", "start": 37.731, "end": 38.049}, {"text": "mas", "start": 38.273, "end": 38.733}, {"text": "se", "start": 38.91, "end": 39.028}, {"text": "alguém", "start": 39.04, "end": 39.323}, {"text": "usar", "start": 39.335, "end": 39.641}, {"text": "ele", "start": 39.924, "end": 40.054}, {"text": "pode", "start": 40.066, "end": 40.337}, {"text": "salvar", "start": 40.349, "end": 40.738}, {"text": "o", "start": 40.75, "end": 40.809}, {"text": "avião", "start": 40.821, "end": 41.21}]}, {"cap": "Você já tinha reparado nesse cinzeiro? Comenta aí.", "start": 41.78, "end": 45.315, "audio_at": 41.72, "dur": 3.774875, "words": [{"text": "Você", "start": 41.78, "end": 42.051}, {"text": "já", "start": 42.063, "end": 42.192}, {"text": "tinha", "start": 42.204, "end": 42.475}, {"text": "reparado", "start": 42.487, "end": 42.959}, {"text": "nesse", "start": 42.971, "end": 43.218}, {"text": "cinzeiro", "start": 43.23, "end": 43.714}, {"text": "Comenta", "start": 44.525, "end": 45.032}, {"text": "aí", "start": 45.043, "end": 45.315}]}]}